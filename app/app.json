{
  "expo": {
    "name": "Koorta",
    "slug": "koorta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.koorta"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#68855B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.koorta",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Koorta usa sua localização para mostrar quadras e sessões próximas e validar seu check-in."
        }
      ],
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#68855B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "scheme": "koorta",
    "experiments": {
      "typedRoutes": false
    },
    "owner": "victorozorios-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ef83019-2c63-4066-94df-b6da41e10b89"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/2ef83019-2c63-4066-94df-b6da41e10b89"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
